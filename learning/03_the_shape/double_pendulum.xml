<mujoco model="double_pendulum">
    <worldbody>
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="1 1 0.01" rgba="0.9 0.9 0.9 1"/>

    <body name="upper_arm" pos="0 0 1.0">
        <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.1"/>
        <geom type="cylinder" size="0.02 0.2" pos="0 0 -0.2" mass="1.0" rgba="0.2 0.6 0.9 1"/>

        <body name="forearm" pos="0 0 -0.4">
            <joint name="elbow" type="hinge" axis="0 1 0"/>
            <geom type="cylinder" size="0.018 0.15" pos="0 0 -0.15" mass="0.8" rgba="0.9 0.5 0.2 1"/>

            <site name="fingertip" pos="0 0 -0.3" size="0.025" rgba="1 0.2 0.2 1"/>]
        </body>
    </body>
    
  </worldbody>
    <actuator>
    <motor name="shoulder_motor" joint="shoulder"/>
    <motor name="elbow_motor" joint="elbow"/>
  </actuator>
</mujoco> 