<mujoco model="simple_pendulum">
  <!-- Visual floor and lighting -->
  <worldbody>
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="1 1 0.01" rgba="0.9 0.9 0.9 1"/>

    <!-- A fixed base stand -->
    <body pos="0 0 1.2">
      <!-- 
        A hinge joint:
        - axis="0 1 0" means it swings around the Y axis (forward/backward)
        - damping="0.0" means frictionless for now
      -->
      <joint name="pin" type="hinge" axis="0 1 0" damping="0.0"/>
      
      <!-- The rod attached to the hinge:
           length = 0.5m (from pos 0 to -0.5), mass = 1 kg -->
      <geom type="cylinder" size="0.02 0.25" pos="0 0 -0.25" rgba="0.85 0.2 0.2 1" mass="1.0"/>
      <!-- A small green ball at the tip so it is easy to track -->
      <geom type="sphere" size="0.04" pos="0 0 -0.5" rgba="0.2 0.8 0.2 1"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="pin"/>
  </actuator>
</mujoco>
