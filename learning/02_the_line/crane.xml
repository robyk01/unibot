<mujoco model="crane">
    <worldbody>
        <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
        <geom type="plane" size="1 1 0.01"/>

        <geom type="cylinder" size="0.06 0.1" pos="0 0 0.1"/>
        <body name="upper_arm" pos="0 0 0.2">
            <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.1"/>
            <geom type="cylinder" size="0.03 0.25" mass="1.5" pos="0 0 0.25"/>

            <body name="forearm" pos="0 0 0.5">
                <joint name="elbow" type="hinge" axis="0 1 0" damping="0.1"/>
                <geom type="cylinder" size="0.02 0.2" mass="1.0" pos="0 0 0.2"/>

                <site name="gripper" size="0.03" pos="0 0 0.4" rgba="1 0.2 0.2 1"/>
            </body>
        </body>

    </worldbody>
    <actuator>
        <motor joint="shoulder"/>
        <motor joint="elbow"/>
    </actuator>
</mujoco>